POSTGRES_DB=smartmall
POSTGRES_USER=smartmall
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_BIND_ADDRESS=127.0.0.1
REDIS_PASSWORD=replace-with-a-different-local-password
REDIS_BIND_ADDRESS=127.0.0.1
SMARTMALL_DB_URL=jdbc:postgresql://127.0.0.1:5432/smartmall
SMARTMALL_DB_USERNAME=smartmall
SMARTMALL_DB_PASSWORD=replace-with-a-local-password
SMARTMALL_REDIS_HOST=127.0.0.1
SMARTMALL_REDIS_PORT=6379
SMARTMALL_REDIS_PASSWORD=replace-with-a-different-local-password
SMARTMALL_REDIS_TIMEOUT=2s
SMARTMALL_ANALYTICS_CACHE_TTL=5m
SMARTMALL_JWT_SECRET=replace-with-at-least-32-random-characters
# 至少 32 个 ASCII 字符；也兼容 32 字节随机值的 Base64 文本。
SMARTMALL_AI_MASTER_KEY=replace-with-at-least-32-characters
SMARTMALL_AI_REQUEST_TIMEOUT=60s
SMARTMALL_BOOTSTRAP_ADMIN_ENABLED=false
SMARTMALL_BOOTSTRAP_ADMIN_USERNAME=admin
SMARTMALL_BOOTSTRAP_ADMIN_EMAIL=admin@smartmall.local
SMARTMALL_BOOTSTRAP_ADMIN_PASSWORD=replace-only-when-bootstrap-is-enabled
