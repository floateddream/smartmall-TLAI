POSTGRES_DB=smartmall
POSTGRES_USER=smartmall
POSTGRES_PASSWORD=replace-with-a-strong-database-password
REDIS_PASSWORD=replace-with-a-different-strong-password
MINIO_ROOT_USER=replace-with-a-non-default-access-name
MINIO_ROOT_PASSWORD=replace-with-a-strong-object-storage-password
SMARTMALL_MINIO_BUCKET=smartmall-documents
SMARTMALL_JWT_SECRET=replace-with-at-least-32-random-characters
SMARTMALL_AI_MASTER_KEY=replace-with-an-independent-32-byte-secret
SMARTMALL_CORS_ALLOWED_ORIGINS=https://mall.example.com
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
SMARTMALL_IMAGE_TAG=local
# 若私有镜像仓库使用不同名称，可显式覆盖；不要使用 latest。
MINIO_IMAGE=smartmall/minio:RELEASE.2025-10-15T17-29-55Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
