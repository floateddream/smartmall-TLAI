# 该文件用于“服务器已经运行 PostgreSQL、Redis、MinIO 和 Ollama”的部署方式。
# 复制为 deploy/.env 后填写真实值；deploy/.env 已被 .gitignore 忽略。

POSTGRES_DB=smartmall
POSTGRES_USER=smartmall
POSTGRES_PASSWORD=replace-with-the-existing-database-password

REDIS_PASSWORD=replace-with-the-existing-redis-password
SMARTMALL_REDIS_TIMEOUT=5s

MINIO_ACCESS_KEY=replace-with-the-existing-minio-access-key
MINIO_SECRET_KEY=replace-with-the-existing-minio-secret-key
SMARTMALL_MINIO_BUCKET=smartmall-documents

SMARTMALL_JWT_SECRET=replace-with-at-least-32-random-characters
SMARTMALL_AI_MASTER_KEY=replace-with-an-independent-32-byte-secret
SMARTMALL_AI_REQUEST_TIMEOUT=60s
SMARTMALL_CORS_ALLOWED_ORIGINS=http://your-server-address

# 现有数据库已经有管理员时保持 false。只有首次创建管理员时才临时设为 true。
SMARTMALL_BOOTSTRAP_ADMIN_ENABLED=false
SMARTMALL_BOOTSTRAP_ADMIN_USERNAME=admin
SMARTMALL_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SMARTMALL_BOOTSTRAP_ADMIN_PASSWORD=replace-only-when-bootstrap-is-enabled

HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
SMARTMALL_IMAGE_TAG=server

# Docker 外部网络名称，可通过 docker network ls 查看。
SMARTMALL_INFRA_NETWORK=infra_default
SMARTMALL_MINIO_NETWORK=minio_default
SMARTMALL_OLLAMA_NETWORK=ollama_default
